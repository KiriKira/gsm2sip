<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <!-- GSM Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GSM"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />

        <!-- Network -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="Network"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView
                android:id="@+id/tvGsmNetwork"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Network Type -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">
            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="Type"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView
                android:id="@+id/tvNetworkType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Signal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">
            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="Signal"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView
                android:id="@+id/tvGsmSignal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Cell ID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">
            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="Cell ID"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView
                android:id="@+id/tvCellId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- IMEI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">
            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="IMEI"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView
                android:id="@+id/tvImei"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Phone Number -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">
            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="Phone"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView
                android:id="@+id/tvPhoneNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginVertical="8dp" />

        <!-- WiFi Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WiFi"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />

        <!-- WiFi Network -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="Network"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView
                android:id="@+id/tvWifiNetwork"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- WiFi Band -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">
            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="Band"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView
                android:id="@+id/tvWifiType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- WiFi Signal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">
            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="Signal"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView
                android:id="@+id/tvWifiSignal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- WiFi IP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">
            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="Local IP"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView
                android:id="@+id/tvWifiIp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginVertical="8dp" />

        <!-- IP Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Internet"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />

        <!-- Public IP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="Public IP"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView
                android:id="@+id/tvPublicIp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="detecting…"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginVertical="8dp" />

        <!-- Check Support Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckSupport"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Check Gateway Support"
            android:textSize="13sp"
            android:textColor="?attr/colorOnPrimary"
            app:backgroundTint="?attr/colorPrimary"
            android:layout_marginTop="4dp" />

        <!-- Check Results Container (populated dynamically) -->
        <LinearLayout
            android:id="@+id/checkResultsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
